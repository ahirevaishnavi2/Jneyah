    <!-- Voice Setup Modal -->
    <div class="modal" id="voiceModal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeVoiceModal()">&times;</button>
            <div class="modal-header">
                <h3>Voice-guided Setup</h3>
                <p>Speak your answers for a hands-free experience</p>
            </div>
            
            <div class="voice-indicator">
                <div class="voice-icon">
                    <i class="fas fa-microphone-alt"></i>
                </div>
                <div class="voice-status" id="voiceStatus">Ready to listen</div>
                <p class="voice-instruction" id="voiceInstruction">Say "Dry", "Oily", "Combination", or "Sensitive" for skin type</p>
            </div>
            
            <div class="form-controls">
                <button class="btn-secondary" onclick="stopVoiceSetup()">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button class="btn" id="voiceActionBtn" onclick="startVoiceListening()">
                    <i class="fas fa-microphone"></i> Start Speaking
                </button>
            </div>
        </div>
    </div>

    <script>
        // Theme Toggle
        const themeToggle = document.getElementById('themeToggle');
        const body = document.body;
        
        themeToggle.addEventListener('click', () => {
            body.classList.toggle('dark-mode');
            localStorage.setItem('theme', body.classList.contains('dark-mode') ? 'dark' : 'light');
        });
        
        // Check for saved theme preference
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark') {
            body.classList.add('dark-mode');
        }
        
        // Setup State
        let currentStep = 1;
        const totalSteps = 4;
        
        // User Profile Data
        const userProfile = {
            skinType: null,
            skinIssues: [],
            foodAllergies: [],
            skinAllergies: [],
            ageGroup: null,
            dietPreference: null,
            accessibility: {
                voice: false,
                language: false
            },
            language: 'en'
        };
        
        // Step Navigation
        function goToStep(step) {
            if (step < 1 || step > totalSteps) return;
            
            // Hide current step
            document.getElementById(`formStep${currentStep}`).classList.remove('active');
            document.getElementById(`step${currentStep}`).classList.remove('active');
            
            // Show new step
            currentStep = step;
            document.getElementById(`formStep${currentStep}`).classList.add('active');
            document.getElementById(`step${currentStep}`).classList.add('active');
            
            // Update progress bar
            const progressFill = document.getElementById('progressFill');
            progressFill.style.width = `${((currentStep - 1) / (totalSteps - 1)) * 100}%`;
            
            // Update titles
            updateStepTitles();
        }
        
        function updateStepTitles() {
            const titles = [
                'Skin & Health Info',
                'Allergies & Age',
                'Diet & Accessibility',
                'Review & Complete'
            ];
            
            const subtitles = [
                'Tell us about your skin type and any skin issues',
                'Select any allergies and optionally your age group',
                'Choose diet preference and accessibility options',
                'Review your selections and complete setup'
            ];
            
            document.getElementById('stepTitle').textContent = titles[currentStep - 1];
            document.getElementById('stepSubtitle').textContent = subtitles[currentStep - 1];
        }
        
        // Selection Functions
        function selectOption(element, category) {
            // Remove selection from siblings
            const siblings = element.parentElement.children;
            for (let sibling of siblings) {
                sibling.classList.remove('selected');
            }
            
            // Select current element
            element.classList.add('selected');
            
            // Update profile data
            const value = element.querySelector('span').textContent;
            userProfile[category] = value;
            
            console.log(`Selected ${category}:`, value);
        }
        
        function toggleChip(element, category) {
            element.classList.toggle('selected');
            
            const value = element.textContent.trim().replace(/^[^a-zA-Z]+/, '');
            
            if (element.classList.contains('selected')) {
                userProfile[category].push(value);
            } else {
                const index = userProfile[category].indexOf(value);
                if (index > -1) {
                    userProfile[category].splice(index, 1);
                }
            }
            
            console.log(`${category}:`, userProfile[category]);
        }
        
        function toggleAccessibility(element, type) {
            element.classList.toggle('selected');
            userProfile.accessibility[type] = element.classList.contains('selected');
            
            // Special handling for voice setup
            if (type === 'voice' && userProfile.accessibility.voice) {
                openVoiceModal();
            }
            
            console.log(`Accessibility ${type}:`, userProfile.accessibility[type]);
        }
        
        // Skip Step
        function skipStep() {
            if (currentStep < totalSteps) {
                goToStep(currentStep + 1);
            } else {
                completeSetup();
            }
        }
        
        // Voice Setup Modal
        function openVoiceModal() {
            document.getElementById('voiceModal').style.display = 'flex';
            document.getElementById('voiceStatus').textContent = 'Ready to listen';
            document.getElementById('voiceInstruction').textContent = 'Say "Dry", "Oily", "Combination", or "Sensitive" for skin type';
            document.getElementById('voiceActionBtn').innerHTML = '<i class="fas fa-microphone"></i> Start Speaking';
        }
        
        function closeVoiceModal() {
            document.getElementById('voiceModal').style.display = 'none';
            userProfile.accessibility.voice = false;
            
            // Deselect voice option
            const voiceOption = document.querySelector('.accessibility-option[onclick*="voice"]');
            if (voiceOption) {
                voiceOption.classList.remove('selected');
            }
        }
        
        function stopVoiceSetup() {
            closeVoiceModal();
        }
        
        function startVoiceListening() {
            const voiceStatus = document.getElementById('voiceStatus');
            const voiceActionBtn = document.getElementById('voiceActionBtn');
            
            // Simulate voice listening
            voiceStatus.textContent = 'Listening...';
            voiceActionBtn.innerHTML = '<div class="spinner"></div> Listening...';
            voiceActionBtn.disabled = true;
            
            // Simulate processing after 2 seconds
            setTimeout(() => {
                voiceStatus.textContent = 'Processing...';
                
                // Simulate successful recognition after another second
                setTimeout(() => {
                    voiceStatus.textContent = 'Recognized: "Combination"';
                    voiceActionBtn.innerHTML = '<i class="fas fa-check"></i> Success';
                    
                    // Update skin type selection
                    const skinOptions = document.querySelectorAll('.icon-option');
                    skinOptions.forEach(option => {
                        if (option.querySelector('span').textContent === 'Combination') {
                            selectOption(option, 'skinType');
                        }
                    });
                    
                    // Close modal after 2 seconds
                    setTimeout(() => {
                        closeVoiceModal();
                    }, 2000);
                }, 1000);
            }, 2000);
        }
        
        // Age Group Change
        document.getElementById('ageGroup').addEventListener('change', function() {
            userProfile.ageGroup = this.value;
            console.log('Age group:', userProfile.ageGroup);
        });
        
        // Language Change
        document.getElementById('language').addEventListener('change', function() {
            userProfile.language = this.value;
            console.log('Language:', userProfile.language);
        });
        
        // Complete Setup
        function completeSetup() {
            // Validate required fields
            if (!userProfile.skinType) {
                alert('Please select your skin type to continue');
                goToStep(1);
                return;
            }
            
            // Show loading state
            const completeBtn = document.querySelector('#formStep4 .btn');
            const originalText = completeBtn.innerHTML;
            completeBtn.innerHTML = '<div class="spinner"></div> Saving Profile...';
            completeBtn.disabled = true;
            
            // Simulate API call
            setTimeout(() => {
                console.log('Profile setup complete:', userProfile);
                
                // Show success message
                alert('Profile setup complete! Personalized recommendations are now enabled.');
                
                // Redirect to dashboard (in real app)
                // window.location.href = '/dashboard.html';
                
                // Reset button
                completeBtn.innerHTML = originalText;
                completeBtn.disabled = false;
            }, 1500);
        }
        
        // Initialize
        updateStepTitles();
        
        // Set up chip selection arrays
        document.querySelectorAll('.chip-selection').forEach(selection => {
            const chips = selection.querySelectorAll('.chip');
            chips.forEach(chip => {
                chip.addEventListener('click', function() {
                    // Determine category from parent label
                    const label = this.closest('.input-group').querySelector('label').textContent;
                    let category = '';
                    
                    if (label.includes('Skin Issues')) category = 'skinIssues';
                    else if (label.includes('Food Allergies')) category = 'foodAllergies';
                    else if (label.includes('Skin Allergies')) category = 'skinAllergies';
                    
                    if (category) {
                        toggleChip(this, category);
                    }
                });
            });
        });
        
        // Initialize accessibility options
        document.querySelectorAll('.accessibility-option').forEach(option => {
            option.addEventListener('click', function() {
                const type = this.getAttribute('onclick').includes('voice') ? 'voice' : 'language';
                toggleAccessibility(this, type);
            });
        });
        
        // Initialize icon options
        document.querySelectorAll('.icon-option').forEach(option => {
            option.addEventListener('click', function() {
                const category = this.getAttribute('onclick').includes('skinType') ? 'skinType' : 'dietPreference';
                selectOption(this, category);
            });
        });
    </script>
</body>
