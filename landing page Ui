        // ========== VOICE FEATURES ==========
        function speakAnalysis(text) {
            stopSpeaking(); // Stop any current speech
    
            // Check if browser supports speech synthesis
            if ('speechSynthesis' in window) {
                currentSpeech = new SpeechSynthesisUtterance(text);
                
                // Configure voice
                currentSpeech.rate = 1.0;
                currentSpeech.pitch = 1.0;
                currentSpeech.volume = 1.0;
                
                // Try to find a female voice for better user experience
                const voices = speechSynthesis.getVoices();
                const femaleVoice = voices.find(voice => 
                    voice.name.includes('Female') || 
                    voice.name.includes('female') ||
                    voice.name.includes('Google UK English Female') ||
                    voice.name.includes('Microsoft Zira Desktop')
                );
                
                if (femaleVoice) {
                    currentSpeech.voice = femaleVoice;
                }
                
                // Add event listeners for better UX
                currentSpeech.onstart = function() {
                    console.log('Speech started');
                };
                
                currentSpeech.onend = function() {
                    console.log('Speech ended');
                    currentSpeech = null;
                };
                
                currentSpeech.onerror = function(event) {
                    console.error('Speech synthesis error:', event);
                    currentSpeech = null;
                    // Fallback to alert if speech fails
                    alert("Text-to-speech failed. Here's the analysis:\n\n" + text);
                };
                
                // Speak the text
                speechSynthesis.speak(currentSpeech);
                
            } else {
                // Fallback for browsers that don't support speech synthesis
                alert("Your browser doesn't support text-to-speech. Here's the analysis:\n\n" + text);
            }
        }
        
        function stopSpeaking() {
            if ('speechSynthesis' in window && speechSynthesis.speaking) {
                speechSynthesis.cancel();
            }
            currentSpeech = null;
        }
        
