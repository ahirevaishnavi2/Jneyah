<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jneyah - Your Personal Ingredient Companion</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', 'Poppins', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
        }
        
        :root {
            /* Perfect Green Theme - Consistent with sign-in */
            --primary-bg: #F1FAF4; /* off-white green background */
            --card-bg: #E6F4EA; /* cards / input fields */
            --cta: #ACE1AF; /* buttons / CTA */
            --cta-dark: #8BCF8F; /* button hover */
            --cta-light: #C2E8C5; /* button light state */
            --text-dark: #2F3E34; /* dark text */
            --text-light: #4A5B50; /* light text */
            --text-lighter: #6B7A6F; /* lighter text */
            --border: #B7E4C7; /* border / divider */
            --border-light: #D4EDDA; /* light border */
            --success: #34A853; /* success green */
            --error: #EA4335; /* error red */
            --warning: #FBBC05; /* warning yellow */
            --info: #4285F4; /* info blue */
            --shadow: rgba(172, 225, 175, 0.2);
            --shadow-dark: rgba(172, 225, 175, 0.3);
            --radius: 16px;
            --radius-sm: 10px;
        }
        
        .dark-mode {
            --primary-bg: #0F2B1C;
            --card-bg: #1A3B27;
            --cta: #4CAF50;
            --cta-dark: #3D8B40;
            --cta-light: #6ABF6D;
            --text-dark: #E8F5E9;
            --text-light: #C8E6C9;
            --text-lighter: #A5D6A7;
            --border: #2E7D32;
            --border-light: #388E3C;
            --success: #4CAF50;
            --error: #F44336;
            --warning: #FFC107;
            --info: #2196F3;
            --shadow: rgba(0, 0, 0, 0.3);
            --shadow-dark: rgba(0, 0, 0, 0.5);
        }
        
        body {
            background-color: var(--primary-bg);
            min-height: 100vh;
            padding: 0;
            margin: 0;
            background-image: 
                radial-gradient(circle at 20% 80%, rgba(172, 225, 175, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(172, 225, 175, 0.1) 0%, transparent 50%),
                linear-gradient(135deg, var(--primary-bg) 0%, #E8F5E9 100%);
        }
        
        .dark-mode body {
            background-image: 
                radial-gradient(circle at 20% 80%, rgba(76, 175, 80, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(76, 175, 80, 0.1) 0%, transparent 50%),
                linear-gradient(135deg, var(--primary-bg) 0%, #1B5E20 100%);
        }
        
        /* Navigation Bar */
        .navbar {
            background: var(--card-bg);
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px var(--shadow);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .navbar-brand h1 {
            font-size: 1.8rem;
            color: var(--text-dark);
            font-weight: 800;
            letter-spacing: 1px;
        }
        
        .navbar-brand span {
            color: var(--cta-dark);
        }
        
        .nav-links {
            display: flex;
            gap: 30px;
            align-items: center;
        }
        
        .nav-links a {
            text-decoration: none;
            color: var(--text-light);
            font-weight: 500;
            font-size: 1rem;
            transition: color 0.3s;
            cursor: pointer;
        }
        
        .nav-links a:hover {
            color: var(--cta);
        }
        
        .nav-links a.active {
            color: var(--cta);
            font-weight: 600;
        }
        
        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .profile-img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--cta);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 1.2rem;
        }
        
        .theme-toggle {
            background: var(--card-bg);
            width: 50px;
            height: 26px;
            border-radius: 50px;
            position: relative;
            cursor: pointer;
            border: 2px solid var(--border);
            box-shadow: 0 2px 8px var(--shadow);
        }
        
        .toggle-slider {
            position: absolute;
            top: 2px;
            left: 2px;
            width: 18px;
            height: 18px;
            background: var(--cta);
            border-radius: 50%;
            transition: transform 0.4s;
        }
        
        .dark-mode .toggle-slider {
            transform: translateX(24px);
        }
        
        .toggle-icon {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            font-size: 11px;
            color: var(--cta);
        }
        
        .sun {
            left: 6px;
        }
        
        .moon {
            right: 6px;
        }
        
        /* Main Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 25px;
        }
        
        /* Welcome Banner */
        .welcome-banner {
            background: linear-gradient(135deg, var(--cta) 0%, var(--cta-dark) 100%);
            border-radius: var(--radius);
            padding: 30px;
            margin-bottom: 30px;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 10px 30px var(--shadow-dark);
            position: relative;
            overflow: hidden;
        }
        
        .welcome-banner::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 200px;
            height: 200px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            filter: blur(20px);
        }
        
        .welcome-text h2 {
            font-size: 1.8rem;
            margin-bottom: 8px;
            font-weight: 700;
        }
        
        .welcome-text p {
            font-size: 1rem;
            opacity: 0.9;
        }
        
        .date-display {
            background: rgba(255, 255, 255, 0.2);
            padding: 12px 20px;
            border-radius: 50px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        /* Main Features Grid */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }
        
        .feature-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 25px;
            border: 1px solid var(--border);
            box-shadow: 0 8px 20px var(--shadow);
            transition: transform 0.3s, box-shadow 0.3s;
            display: flex;
            flex-direction: column;
        }
        
        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px var(--shadow-dark);
        }
        
        .feature-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            gap: 15px;
        }
        
        .feature-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: var(--cta-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dark);
            font-size: 1.5rem;
        }
        
        .feature-title {
            font-size: 1.4rem;
            color: var(--text-dark);
            font-weight: 600;
        }
        
        .feature-subtitle {
            color: var(--text-light);
            font-size: 0.9rem;
            margin-top: 5px;
        }
        
        /* Upload & Know Feature */
        .upload-zone {
            border: 2px dashed var(--border);
            border-radius: var(--radius-sm);
            padding: 30px;
            text-align: center;
            margin-top: 15px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .upload-zone:hover {
            border-color: var(--cta);
            background: rgba(172, 225, 175, 0.1);
        }
        
        .upload-icon {
            font-size: 2.5rem;
            color: var(--cta);
            margin-bottom: 15px;
        }
        
        .upload-text {
            color: var(--text-light);
            margin-bottom: 15px;
        }
        
        .upload-btn {
            background: var(--cta);
            color: var(--text-dark);
            border: none;
            padding: 12px 24px;
            border-radius: var(--radius-sm);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        
        .upload-btn:hover {
            background: var(--cta-dark);
            color: white;
            transform: translateY(-2px);
        }
        
        /* Safety Results */
        .safety-results {
            display: none;
            margin-top: 20px;
            animation: fadeIn 0.5s ease;
        }
        
        .safety-card {
            background: white;
            border-radius: var(--radius-sm);
            padding: 20px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            border-left: 5px solid var(--success);
        }
        
        .safety-card.warning {
            border-left-color: var(--warning);
        }
        
        .safety-card.danger {
            border-left-color: var(--error);
        }
        
        .safety-status {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }
        
        .safety-dot {
            width: 15px;
            height: 15px;
            border-radius: 50%;
        }
        
        .safety-dot.safe {
            background: var(--success);
        }
        
        .safety-dot.warning {
            background: var(--warning);
        }
        
        .safety-dot.danger {
            background: var(--error);
        }
        
        .safety-title {
            font-weight: 700;
            font-size: 1.2rem;
        }
        
        .safety-desc {
            color: var(--text-light);
            font-size: 0.95rem;
            line-height: 1.5;
            margin-bottom: 15px;
        }
        
        .voice-explain {
            background: var(--cta-light);
            padding: 15px;
            border-radius: var(--radius-sm);
            margin-top: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .voice-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .voice-btn-small {
            background: var(--cta);
            color: var(--text-dark);
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }
        
        .voice-btn-small:hover {
            background: var(--cta-dark);
            transform: scale(1.1);
        }
        
        /* Manual Input */
        .manual-input {
            margin-top: 15px;
        }
        
        .ingredient-input {
            width: 100%;
            min-height: 120px;
            padding: 15px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--card-bg);
            color: var(--text-dark);
            font-size: 1rem;
            resize: vertical;
        }
        
        .ingredient-input:focus {
            outline: none;
            border-color: var(--cta);
        }
        
        /* Ingredient of the Day */
        .ingredient-card {
            background: linear-gradient(135deg, var(--cta-light) 0%, var(--cta) 100%);
            border-radius: var(--radius);
            padding: 25px;
            color: var(--text-dark);
        }
        
        .ingredient-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .ingredient-name {
            font-size: 1.4rem;
            font-weight: 700;
        }
        
        .ingredient-type {
            background: rgba(255, 255, 255, 0.3);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        
        .ingredient-desc {
            margin-bottom: 20px;
            line-height: 1.5;
        }
        
        .ingredient-interactions {
            display: flex;
            gap: 10px;
        }
        
        .interaction-btn {
            flex: 1;
            background: rgba(255, 255, 255, 0.3);
            border: none;
            padding: 10px;
            border-radius: var(--radius-sm);
            color: var(--text-dark);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .interaction-btn:hover {
            background: rgba(255, 255, 255, 0.5);
            transform: translateY(-2px);
        }
        
        /* Community Section */
        .community-questions {
            margin-top: 15px;
        }
        
        .question-card {
            background: white;
            border-radius: var(--radius-sm);
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid var(--border-light);
        }
        
        .question-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }
        
        .user-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: var(--cta-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dark);
            font-weight: 600;
        }
        
        .question-title {
            font-weight: 600;
            color: var(--text-dark);
        }
        
        .question-text {
            color: var(--text-light);
            font-size: 0.9rem;
            margin-bottom: 10px;
            line-height: 1.4;
        }
        
        .question-stats {
            display: flex;
            justify-content: space-between;
            color: var(--text-lighter);
            font-size: 0.85rem;
        }
        
        .ask-question {
            margin-top: 20px;
        }
        
        .ask-input {
            width: 100%;
            padding: 15px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--card-bg);
            color: var(--text-dark);
            font-size: 1rem;
            margin-bottom: 10px;
        }
        
        /* Chatbot Section */
        .chatbot-container {
            margin-top: 15px;
            display: flex;
            flex-direction: column;
            height: 300px;
        }
        
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            background: white;
            border-radius: var(--radius-sm);
            margin-bottom: 15px;
            border: 1px solid var(--border-light);
        }
        
        .message {
            margin-bottom: 15px;
            max-width: 80%;
        }
        
        .message.user {
            margin-left: auto;
        }
        
        .message.bot {
            margin-right: auto;
        }
        
        .message-content {
            padding: 12px 16px;
            border-radius: 18px;
            line-height: 1.4;
        }
        
        .message.user .message-content {
            background: var(--cta);
            color: var(--text-dark);
            border-bottom-right-radius: 5px;
        }
        
        .message.bot .message-content {
            background: var(--card-bg);
            color: var(--text-dark);
            border-bottom-left-radius: 5px;
        }
        
        .chat-input-container {
            display: flex;
            gap: 10px;
        }
        
        .chat-input {
            flex: 1;
            padding: 15px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--card-bg);
            color: var(--text-dark);
            font-size: 1rem;
        }
        
        .voice-btn {
            background: var(--cta);
            color: var(--text-dark);
            border: none;
            width: 50px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 1.2rem;
        }
        
        /* Health Streaks */
        .streaks-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 15px;
        }
        
        .streak-card {
            background: white;
            border-radius: var(--radius-sm);
            padding: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
            border: 1px solid var(--border-light);
        }
        
        .streak-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--cta-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--cta-dark);
            font-size: 1.2rem;
        }
        
        .streak-info {
            flex: 1;
        }
        
        .streak-name {
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 3px;
        }
        
        .streak-days {
            color: var(--text-light);
            font-size: 0.9rem;
        }
        
        .streak-progress {
            height: 6px;
            background: var(--border-light);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 5px;
        }
        
        .progress-bar {
            height: 100%;
            background: var(--success);
            border-radius: 3px;
        }
        
        /* Badges */
        .badges-container {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 15px;
        }
        
        .badge {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 8px 15px;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-light);
            display: flex;
            align-items: center;
            gap: 8px;
            border: 2px solid var(--border);
        }
        
        .badge.earned {
            border-color: var(--success);
            background: var(--cta-light);
            color: var(--text-dark);
        }
        
        /* Insights */
        .insights-container {
            margin-top: 15px;
        }
        
        .insight-card {
            background: white;
            border-radius: var(--radius-sm);
            padding: 20px;
            margin-bottom: 15px;
            border: 1px solid var(--border-light);
        }
        
        .insight-title {
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 10px;
            font-size: 1.1rem;
        }
        
        .insight-stats {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--cta-dark);
        }
        
        .stat-label {
            font-size: 0.8rem;
            color: var(--text-light);
        }
        
        .insight-text {
            color: var(--text-light);
            font-size: 0.9rem;
            line-height: 1.5;
            padding: 12px;
            background: var(--card-bg);
            border-radius: var(--radius-sm);
            border-left: 4px solid var(--cta);
        }
        
        /* Alerts */
        .alerts-container {
            margin-top: 15px;
        }
        
        .alert-card {
            background: rgba(251, 188, 5, 0.1);
            border-radius: var(--radius-sm);
            padding: 15px;
            margin-bottom: 10px;
            border-left: 4px solid var(--warning);
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .alert-card.expiry {
            background: rgba(234, 67, 53, 0.1);
            border-left: 4px solid var(--error);
        }
        
        .alert-icon {
            color: var(--warning);
            font-size: 1.2rem;
        }
        
        .alert-icon.expiry {
            color: var(--error);
        }
        
        .alert-text {
            color: var(--text-dark);
            font-size: 0.9rem;
            flex: 1;
        }
        
        /* History */
        .history-container {
            margin-top: 15px;
            max-height: 300px;
            overflow-y: auto;
        }
        
        .history-item {
            display: flex;
            align-items: center;
            padding: 12px;
            border-bottom: 1px solid var(--border-light);
        }
        
        .history-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--cta-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dark);
            margin-right: 15px;
        }
        
        .history-info {
            flex: 1;
        }
        
        .history-name {
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 3px;
        }
        
        .history-date {
            color: var(--text-light);
            font-size: 0.8rem;
        }
        
        .history-status {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        
        .status-safe {
            background: rgba(52, 168, 83, 0.1);
            color: var(--success);
        }
        
        .status-warning {
            background: rgba(251, 188, 5, 0.1);
            color: var(--warning);
        }
        
        .status-danger {
            background: rgba(234, 67, 53, 0.1);
            color: var(--error);
        }
        
        /* Buttons */
        .btn {
            background: var(--cta);
            color: var(--text-dark);
            border: none;
            padding: 12px 24px;
            border-radius: var(--radius-sm);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        
        .btn:hover {
            background: var(--cta-dark);
            color: white;
            transform: translateY(-2px);
        }
        
        .btn-sm {
            padding: 8px 16px;
            font-size: 0.9rem;
        }
        
        /* Footer */
        .footer {
            text-align: center;
            padding: 25px;
            color: var(--text-light);
            font-size: 0.9rem;
            border-top: 1px solid var(--border);
            margin-top: 40px;
        }
        
        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 43, 28, 0.8);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }
        
        .modal-content {
            background: var(--card-bg);
