            initials: 'U',
            joinDate: new Date().toISOString()
        };
        
        // ========== APP STATE ==========
        let userData = JSON.parse(localStorage.getItem('jneyah_user_data')) || {
            streaks: {
                water: { current: 0, max: 0, lastUpdated: null },
                food: { current: 0, max: 0, lastUpdated: null },
                skin: { current: 0, max: 0, lastUpdated: null }
