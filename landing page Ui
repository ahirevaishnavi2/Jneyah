            };
            
            // Check for specific ingredient queries
            for (const [keyword, response] of Object.entries(ingredientKnowledge)) {
                if (lowerMsg.includes(keyword)) {
                    return response;
                }
            }
            
            // Check for question patterns
            if (lowerMsg.includes('what is') || lowerMsg.includes('tell me about')) {
                const ingredient = lowerMsg.replace('what is', '').replace('tell me about', '').trim();
                if (ingredient) {
                    return `I'd be happy to tell you about ${ingredient}! However, I need more specific information. Could you clarify which ingredient you mean? Or try asking about common ingredients like hyaluronic acid, retinol, or niacinamide.`;
                }
            }
            
            if (lowerMsg.includes('good for') || lowerMsg.includes('help with')) {
                return 'I can recommend ingredients for specific concerns! Try asking: "What ingredients are good for acne?" or "What helps with dry skin?"';
            }
            
            if (lowerMsg.includes('bad for') || lowerMsg.includes('avoid')) {
                return 'Some ingredients to be cautious about: fragrance (irritant), alcohol denat (drying), certain preservatives if sensitive. What specific ingredient are you concerned about?';
            }
            
            if (lowerMsg.includes('thank') || lowerMsg.includes('thanks')) {
                return 'You\'re welcome! Feel free to ask more questions about ingredients anytime.';
            }
            
            if (lowerMsg.includes('hello') || lowerMsg.includes('hi') || lowerMsg.includes('hey')) {
                return 'Hello! I\'m your Ingredient Buddy. Ask me anything about skincare or food ingredients!';
            }
            
            if (lowerMsg.includes('how are you')) {
                return 'I\'m just a bot, but I\'m here and ready to help you with all your ingredient questions!';
            }
            
            if (lowerMsg.includes('bye') || lowerMsg.includes('goodbye')) {
                return 'Goodbye! Remember to check ingredients before using new products. Stay safe!';
            }
            
            // Default response for unrecognized queries
            const defaultResponses = [
                "I'm here to help with ingredient questions! Try asking about specific ingredients or skincare concerns.",
                "I can explain ingredients and their effects on skin/health. What would you like to know?",
                "Need help understanding an ingredient list? Share what you're curious about!",
                "I specialize in ingredient knowledge. Ask me about anything from hyaluronic acid to preservatives!"
            ];
            
            return defaultResponses[Math.floor(Math.random() * defaultResponses.length)];
        }
        
