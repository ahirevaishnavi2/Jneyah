                total: 0,
                safe: 0,
                warning: 0,
                danger: 0,
                commonIngredients: {},
                lastScanDate: null
            },
            history: []
        };
        
        let currentSpeech = null;
        
        // ========== INITIALIZATION ==========
        document.addEventListener('DOMContentLoaded', () => {
            console.log('Jneyah Home Screen loaded');
            
            // Update UI with saved data
            document.getElementById('welcomeMessage').textContent = `Welcome back, ${currentUser.name}!`;
            document.getElementById('userInitial').textContent = currentUser.initials;
            
            // Initialize streaks
            updateStreakUI();
            
            // Initialize badges
            updateBadgesUI();
            
            // Initialize scan stats
            updateScanStatsUI();
            
            // Initialize history
            updateHistoryDisplay();
            
            // Check and update streaks based on last activity
            checkStreakContinuity();
            
            // Set up real-time date
            updateRealTimeDate();
            setInterval(updateRealTimeDate, 1000);
            
            // Set up theme
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.body.classList.add('dark-mode');
            }
            
            // Close modals when clicking outside
            window.addEventListener('click', function(e) {
                const modals = document.querySelectorAll('.modal');
                modals.forEach(modal => {
                    if (e.target === modal) {
                        modal.style.display = 'none';
                    }
                });
            });
        });
        
        // ========== THEME TOGGLE ==========
        document.getElementById('themeToggle').addEventListener('click', () => {
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light');
        });
        
        // ========== REAL-TIME DATE ==========
        function updateRealTimeDate() {
            const now = new Date();
            const options = { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            };
            document.getElementById('currentDate').textContent = now.toLocaleDateString('en-US', options);
        }
        
        // ========== UPLOAD & KNOW ==========
        const uploadZone = document.getElementById('uploadZone');
        const fileInput = document.getElementById('fileInput');
        
        uploadZone.addEventListener('click', () => {
            fileInput.click();
        });
        
        uploadZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadZone.style.borderColor = 'var(--cta)';
            uploadZone.style.background = 'rgba(172, 225, 175, 0.1)';
        });
        
        uploadZone.addEventListener('dragleave', () => {
            uploadZone.style.borderColor = 'var(--border)';
            uploadZone.style.background = 'transparent';
        });
        
        uploadZone.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadZone.style.borderColor = 'var(--border)';
            uploadZone.style.background = 'transparent';
            
            if (e.dataTransfer.files.length) {
                handleFileUpload({ target: { files: e.dataTransfer.files } });
            }
        });
        
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            // Show loading state
            uploadZone.innerHTML = `
                <div class="upload-icon">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
                <div class="upload-text">
                    Analyzing ${file.name}...
                </div>
            `;
            
            // Simulate analysis delay
            setTimeout(() => {
                const result = analyzeUploadedProduct();
                
                document.getElementById('safetyResults').innerHTML = `
                    <div class="safety-card ${result.safety}">
                        <div class="safety-status">
                            <div class="safety-dot ${result.safety}"></div>
                            <div class="safety-title">${result.title}</div>
                        </div>
                        <div class="safety-desc">
                            ${result.desc}
                        </div>
                        <div class="voice-explain">
                            <div class="voice-controls">
                                <button class="voice-btn-small" onclick="speakAnalysis('${result.voice}')">
                                    <i class="fas fa-volume-up"></i>
                                </button>
                                <button class="voice-btn-small" onclick="stopSpeaking()">
                                    <i class="fas fa-stop"></i>
                                </button>
                            </div>
                            <div>"${result.voice}"</div>
                        </div>
                    </div>
                `;
                
                document.getElementById('safetyResults').style.display = 'block';
                
                // Add to history and update stats
                addToHistory(result.product, result.safety, 'upload');
                
                // Update skin-safe streak if safe
                if (result.safety === 'safe') {
                    updateStreakCount('skin', true);
                } else {
                    updateStreakCount('skin', false);
                }
                
                // Reset upload zone
                setTimeout(() => {
                    uploadZone.innerHTML = `
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <div class="upload-text">
                            Drag & drop or click to upload another image
                        </div>
                        <button class="upload-btn" onclick="openCamera()">
                            <i class="fas fa-camera"></i> Take Photo
                        </button>
                    `;
