            `;
            
            modal.style.display = 'flex';
        }
        
        function editProfile() {
            const newName = prompt('Enter your name:', currentUser.name);
            if (newName && newName.trim()) {
                currentUser.name = newName.trim();
                currentUser.initials = newName.trim().split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
                
                localStorage.setItem('jneyah_user', JSON.stringify(currentUser));
                
                document.getElementById('welcomeMessage').textContent = `Welcome back, ${currentUser.name}!`;
                document.getElementById('userInitial').textContent = currentUser.initials;
                
                alert('Profile updated successfully!');
                closeModal('settingsModal');
                showSettings();
            }
        }
        
        function showPrivacyPolicy() {
            alert('Privacy Policy: Your data is encrypted and stored securely. We use your scan history only to provide personalized insights. You can delete your data anytime from settings.');
        }
        
        function logout() {
            if (confirm('Are you sure you want to sign out?')) {
                alert('Signed out successfully. Redirecting to login...');
                // window.location.href = 'signin.html';
            }
        }
        
        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }
        
        function showHome() {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => modal.style.display = 'none');
            document.getElementById('mainContent').style.display = 'block';
        }
        
        // ========== COMMUNITY QUESTION ==========
        function askQuestion() {
            const askInput = document.getElementById('askInput');
            const question = askInput.value.trim();
            
            if (!question) {
                alert('Please enter a question.');
                return;
            }
            
            alert('Your question has been posted to the community! Our experts and other users will respond soon.');
            askInput.value = '';
            
            updateStreakCount('learning', true);
        }
        
        // ========== INGREDIENT OF THE DAY ==========
        function rateIngredient(type) {
            const messages = {
                helpful: 'Thanks for your feedback! We\'ll show more helpful content like this.',
                confusing: 'Thanks! We\'ll try to explain ingredients more clearly.',
                new: 'Glad you learned something new! Keep exploring.'
            };
            
            alert(messages[type]);
            updateStreakCount('learning', true);
        }
    </script>
