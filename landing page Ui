        function updateStreakCount(type, success) {
            const today = new Date().toDateString();
            const lastUpdated = userData.streaks[type].lastUpdated;
            
            if (lastUpdated === today) {
                // Already updated today
                return;
            }
            
            if (lastUpdated) {
                const lastDate = new Date(lastUpdated);
                const todayDate = new Date(today);
                const diffTime = Math.abs(todayDate - lastDate);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                
                if (diffDays === 1) {
                    // Consecutive day
                    if (success) {
                        userData.streaks[type].current++;
                        userData.streaks[type].max = Math.max(userData.streaks[type].max, userData.streaks[type].current);
                    } else {
                        userData.streaks[type].current = 0;
                    }
                } else if (diffDays > 1) {
                    // Streak broken
                    userData.streaks[type].current = success ? 1 : 0;
                }
            } else {
                // First time
                userData.streaks[type].current = success ? 1 : 0;
                userData.streaks[type].max = success ? 1 : 0;
            }
            
            userData.streaks[type].lastUpdated = today;
            updateStreakUI();
            updateBadgesUI();
            saveUserData();
            
            // Visual feedback
            const streakElement = document.querySelector(`#${type}Streak`).parentElement.parentElement;
            streakElement.style.animation = 'bounce 0.5s';
            setTimeout(() => {
                streakElement.style.animation = '';
            }, 500);
        }
        
        function checkStreakContinuity() {
            const today = new Date().toDateString();
            
            // Check water streak - reset if not logged today
            if (userData.streaks.water.lastUpdated !== today) {
                // For demo, we'll randomly decide if they maintained it
                if (Math.random() > 0.3) {
                    userData.streaks.water.current = 0;
                }
            }
            
            // Check other streaks similarly
            updateStreakUI();
        }
        
