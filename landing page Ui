            for (const [keyword, response] of Object.entries(ingredientKnowledge)) {
                if (lowerMsg.includes(keyword.toLowerCase())) {
                    return response;
                }
            }
            
            // Check for question patterns
            const questionPatterns = [
                { pattern: /what (is|are) (.+)/i, response: (match) => {
                    const ingredient = match[2];
                    return `I'd be happy to tell you about ${ingredient}! From my knowledge, ${ingredient} is ${ingredientKnowledge[ingredient.toLowerCase()] ? 'an ingredient I know about. ' + ingredientKnowledge[ingredient.toLowerCase()] : 'not in my specific database. Could you ask about a more common ingredient like hyaluronic acid, retinol, or niacinamide?'}`;
                }},
                { pattern: /tell me about (.+)/i, response: (match) => {
                    const ingredient = match[1];
                    return `About ${ingredient}: ${ingredientKnowledge[ingredient.toLowerCase()] || "I don't have specific information on that ingredient. Try asking about common skincare ingredients or specific concerns."}`;
                }},
                { pattern: /is (.+) (good|bad|safe|dangerous)/i, response: (match) => {
                    const ingredient = match[1];
                    const qualifier = match[2];
                    if (ingredientKnowledge[ingredient.toLowerCase()]) {
                        const info = ingredientKnowledge[ingredient.toLowerCase()];
                        if (info.includes('⚠️')) {
                            return `${ingredient} is ${qualifier === 'good' ? 'not recommended' : qualifier} because: ${info}`;
                        } else {
                            return `${ingredient} is generally ${qualifier === 'bad' ? 'not ' : ''}${qualifier === 'bad' ? 'recommended' : qualifier}. ${info}`;
                        }
                    }
                    return `I can't specifically assess ${ingredient}. Try asking about ingredients like fragrance, parabens, or alcohol in skincare.`;
                }},
                { pattern: /how (to|do i) (.+)/i, response: () => {
                    return "I can help with 'how to' questions! Try: 'How to use retinol?' or 'How to treat acne?' or 'How to layer skincare?'";
                }},
                { pattern: /best (.+) for (.+)/i, response: (match) => {
                    const product = match[1];
                    const concern = match[2];
                    return `For ${concern}, good ${product} options would contain: ${getRecommendation(concern, product)}`;
                }},
                { pattern: /(hello|hi|hey)/i, response: () => {
                    return 'Hello! I\'m your Ingredient Buddy. Ask me anything about skincare or food ingredients! Try: "Is niacinamide good for acne?" or "What does hyaluronic acid do?"';
                }},
                { pattern: /thank/i, response: () => {
                    return 'You\'re welcome! Feel free to ask more questions about ingredients anytime.';
                }},
                { pattern: /bye|goodbye/i, response: () => {
                    return 'Goodbye! Remember to check ingredients before using new products. Stay safe!';
                }}
            ];
            
            for (const {pattern, response} of questionPatterns) {
                const match = userMessage.match(pattern);
                if (match) {
                    return response(match);
                }
            }
            
            // Default response
            const defaultResponses = [
                "I'm here to help with ingredient questions! Try asking about specific ingredients or skincare concerns.",
                "I can explain ingredients and their effects on skin/health. What would you like to know?",
                "Need help understanding an ingredient list? Share what you're curious about!",
