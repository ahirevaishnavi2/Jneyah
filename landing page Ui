    <script>
        // ========== USER MANAGEMENT ==========
        // Get user from localStorage or use default
        let currentUser = JSON.parse(localStorage.getItem('jneyah_user')) || {
            name: 'User',
            email: '',
            initials: 'U',
            joinDate: new Date().toISOString()
        };
        
        // Update welcome message and profile
        document.getElementById('welcomeMessage').textContent = `Welcome back, ${currentUser.name}!`;
        document.getElementById('userInitial').textContent = currentUser.initials;
        
        // ========== REAL-TIME DATE ==========
        function updateRealTimeDate() {
            const now = new Date();
            const options = { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            };
            document.getElementById('currentDate').textContent = now.toLocaleDateString('en-US', options);
        }
        
        // Update date immediately and every second
        updateRealTimeDate();
        setInterval(updateRealTimeDate, 1000);
        
        // ========== THEME TOGGLE ==========
        const themeToggle = document.getElementById('themeToggle');
        const body = document.body;
        
        themeToggle.addEventListener('click', () => {
            body.classList.toggle('dark-mode');
            localStorage.setItem('theme', body.classList.contains('dark-mode') ? 'dark' : 'light');
        });
        
        // Check for saved theme preference
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark') {
            body.classList.add('dark-mode');
        }
        
        // ========== UPLOAD & KNOW ==========
        const uploadZone = document.getElementById('uploadZone');
        const fileInput = document.getElementById('fileInput');
        const safetyResults = document.getElementById('safetyResults');
        
        uploadZone.addEventListener('click', () => {
            fileInput.click();
        });
        
        uploadZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadZone.style.borderColor = 'var(--cta)';
            uploadZone.style.background = 'rgba(172, 225, 175, 0.1)';
        });
        
        uploadZone.addEventListener('dragleave', () => {
            uploadZone.style.borderColor = 'var(--border)';
            uploadZone.style.background = 'transparent';
        });
        
        uploadZone.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadZone.style.borderColor = 'var(--border)';
            uploadZone.style.background = 'transparent';
            
            if (e.dataTransfer.files.length) {
                handleFileUpload({ target: { files: e.dataTransfer.files } });
            }
        });
        
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            // Show loading state
            uploadZone.innerHTML = `
                <div class="upload-icon">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
                <div class="upload-text">
                    Analyzing ${file.name}...
                </div>
            `;
            
            // Simulate analysis delay
            setTimeout(() => {
                // Random safety result for demo
                const results = [
                    { 
                        type: 'safe', 
                        title: 'Safe for you', 
                        desc: 'This product contains ingredients compatible with your skin profile. No known allergens or irritants detected.', 
                        voice: 'This product is gentle and suitable for daily use. Contains hydrating ingredients like hyaluronic acid.',
                        product: 'Moisturizer'
                    },
                    { 
                        type: 'warning', 
                        title: 'Use carefully', 
                        desc: 'Contains moderate fragrance that may cause irritation for sensitive skin. Patch test recommended.', 
                        voice: 'This product may cause mild irritation if you have sensitive skin.',
                        product: 'Face Wash'
                    },
                    { 
                        type: 'danger', 
                        title: 'Avoid', 
                        desc: 'Contains alcohol and strong fragrances that can dry and irritate your skin type. Not recommended.', 
                        voice: 'This product may cause irritation because of fragrance and alcohol together.',
                        product: 'Toner'
                    }
                ];
                
                const result = results[Math.floor(Math.random() * results.length)];
                
                safetyResults.innerHTML = `
                    <div class="safety-card ${result.type}">
                        <div class="safety-status">
                            <div class="safety-dot ${result.type}"></div>
                            <div class="safety-title">${result.title}</div>
                        </div>
                        <div class="safety-desc">
                            ${result.desc}
                        </div>
                        <div class="voice-explain">
                            <div class="voice-icon">
                                <i class="fas fa-volume-up"></i>
                            </div>
                            <div>"${result.voice}"</div>
                        </div>
                    </div>
                `;
                
                safetyResults.style.display = 'block';
                
                // Add to history
                addToHistory(result.product, result.type, file.name);
                
                // Update streaks if safe
                if (result.type === 'safe') {
                    updateStreak('skin-safe');
                }
                
                // Reset upload zone after 3 seconds
                setTimeout(() => {
                    uploadZone.innerHTML = `
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <div class="upload-text">
                            Drag & drop or click to upload another image
                        </div>
                        <button class="upload-btn" onclick="openCamera()">
                            <i class="fas fa-camera"></i> Take Photo
                        </button>
                    `;
                }, 3000);
            }, 2000);
        }
        
        function openCamera() {
            alert('Camera would open in a real app. For demo, use the file upload option.');
        }
        
        // ========== MANUAL INGREDIENT ANALYSIS ==========
        function analyzeIngredients() {
            const input = document.getElementById('ingredientInput');
            const text = input.value.trim();
            
            if (!text) {
                alert('Please enter some ingredients to analyze.');
                return;
            }
            
            // Show loading
            const originalText = input.value;
            input.value = 'Analyzing ingredients...';
            input.disabled = true;
            
            setTimeout(() => {
                // Analyze ingredients
                const analysis = analyzeIngredientText(text);
                
                // Show modal with results
                showAnalysisResult(analysis);
                
                // Reset input
                input.value = originalText;
                input.disabled = false;
                
                // Update streak if safe
                if (analysis.safety === 'safe') {
                    updateStreak('skin-safe');
                }
                
                // Add to history
                addToHistory('Manual Analysis', analysis.safety, text.substring(0, 30) + '...');
            }, 1500);
        }
        
        function analyzeIngredientText(text) {
            const lowerText = text.toLowerCase();
            
            // Dangerous ingredients
            const dangerousIngredients = [
                'kerosene', 'gasoline', 'petroleum', 'formaldehyde', 'asbestos', 'lead', 'mercury',
                'arsenic', 'cyanide', 'bleach', 'ammonia', 'hydrochloric acid', 'sulfuric acid'
            ];
            
            // Common irritants
            const irritants = [
                'alcohol denat', 'fragrance', 'parfum', 'perfume', 'essential oil', 'menthol',
                'camphor', 'eucalyptus', 'peppermint', 'citrus oil', 'limonene', 'linalool'
            ];
            
            // Check for dangerous ingredients
            for (const ingredient of dangerousIngredients) {
                if (lowerText.includes(ingredient)) {
                    return {
                        safety: 'danger',
                        title: '⚠️ DANGEROUS - AVOID IMMEDIATELY',
                        desc: `This product contains ${ingredient.toUpperCase()} which is HIGHLY TOXIC and should never be used on skin or consumed.`,
                        recommendations: ['Dispose of this product safely', 'Do not use under any circumstances', 'Wash skin immediately if contacted']
                    };
                }
            }
            
            // Check for multiple irritants
            let irritantCount = 0;
            for (const irritant of irritants) {
                if (lowerText.includes(irritant)) irritantCount++;
            }
            
            if (irritantCount >= 2) {
                return {
                    safety: 'danger',
                    title: 'Avoid',
                    desc: 'Contains multiple potential irritants that may cause skin reactions or sensitivity.',
                    recommendations: ['Not recommended for sensitive skin', 'Consider patch testing', 'Look for fragrance-free alternatives']
                };
            } else if (irritantCount === 1) {
                return {
                    safety: 'warning',
                    title: 'Use Carefully',
                    desc: 'Contains potential irritants. May cause issues for sensitive skin types.',
                    recommendations: ['Patch test recommended', 'Monitor for any reactions', 'Suitable for occasional use only']
                };
            } else {
                return {
                    safety: 'safe',
                    title: 'Safe for you',
                    desc: 'Ingredients appear generally safe with no major red flags detected.',
                    recommendations: ['Suitable for regular use', 'No special precautions needed', 'Good choice for most skin types']
                };
            }
        }
        
        function showAnalysisResult(analysis) {
            const modal = document.createElement('div');
            modal.className = 'modal';
            modal.id = 'analysisModal';
            modal.innerHTML = `
                <div class="modal-content">
                    <button class="close-modal" onclick="closeModal('analysisModal')">&times;</button>
                    <div class="modal-header">
                        <h3>Analysis Results</h3>
                        <p>Ingredient safety assessment</p>
                    </div>
                    <div class="safety-card ${analysis.safety}" style="margin: 20px 0;">
                        <div class="safety-status">
                            <div class="safety-dot ${analysis.safety}"></div>
                            <div class="safety-title">${analysis.title}</div>
                        </div>
                        <div class="safety-desc">
                            ${analysis.desc}
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <h4 style="color: var(--text-dark); margin-bottom: 10px;">Recommendations:</h4>
                        <ul style="color: var(--text-light); padding-left: 20px;">
                            ${analysis.recommendations.map(rec => `<li>${rec}</li>`).join('')}
                        </ul>
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            modal.style.display = 'flex';
            
            // Auto-close after 10 seconds
            setTimeout(() => {
                if (modal.parentNode) {
                    closeModal('analysisModal');
                }
            }, 10000);
        }
        
