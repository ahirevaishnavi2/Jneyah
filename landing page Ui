            localStorage.setItem('jneyah_history', JSON.stringify(scanHistory));
            updateHistoryDisplay();
        }
        
        function generateHistoryItems() {
            return scanHistory.map(item => {
                const date = new Date(item.date);
                const timeAgo = getTimeAgo(date);
                
                return `
                    <div class="history-item">
                        <div class="history-icon">
                            <i class="fas fa-${item.source === 'upload' ? 'camera' : 'keyboard'}"></i>
                        </div>
                        <div class="history-info">
                            <div class="history-name">${item.product}</div>
                            <div class="history-date">${timeAgo}</div>
                        </div>
                        <div class="history-status status-${item.type}">
                            ${item.type === 'safe' ? 'Safe' : item.type === 'warning' ? 'Caution' : 'Avoid'}
                        </div>
                    </div>
                `;
            }).join('');
        }
        
        function updateHistoryDisplay() {
            const historyContainer = document.getElementById('historyContainer');
