        }
        
        .modal-header h3 {
            color: var(--cta);
            font-size: 1.5rem;
            margin-bottom: 10px;
        }
        
        .modal-header p {
            color: var(--text-light);
            font-size: 0.95rem;
        }
        
        .close-modal {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--text-light);
            cursor: pointer;
        }
        
