        function analyzeIngredientText(text) {
            const lowerText = text.toLowerCase();
            
            // Comprehensive ingredient database
            const dangerousIngredients = [
                'kerosene', 'gasoline', 'petroleum (crude)', 'formaldehyde', 'asbestos', 'lead', 'mercury',
                'arsenic', 'cyanide', 'bleach', 'ammonia', 'hydrochloric acid', 'sulfuric acid',
                'methylisothiazolinone', 'triclosan', 'hydroquinone', 'coal tar', 'toluene',
                'phthalates', 'parabens', 'sodium lauryl sulfate', 'sodium laureth sulfate',
                'alcohol denat.', 'ethanol', 'isopropyl alcohol', 'sd alcohol',
                'fragrance', 'parfum', 'perfume', 'essential oil', 'limonene', 'linalool',
                'menthol', 'camphor', 'eucalyptus oil', 'peppermint oil', 'citrus oil'
            ];
            
            const irritants = [
                'alcohol denat.', 'ethanol', 'isopropyl alcohol', 'sd alcohol',
                'fragrance', 'parfum', 'perfume', 'essential oil',
                'menthol', 'camphor', 'eucalyptus', 'peppermint', 'citrus oil',
                'limonene', 'linalool', 'citral', 'geraniol', 'citronellol'
            ];
            
            const safeIngredients = [
                'water', 'glycerin', 'hyaluronic acid', 'niacinamide',
                'ceramides', 'peptides', 'squalane', 'vitamin e', 'vitamin c',
                'green tea extract', 'centella asiatica', 'aloe vera',
                'oat extract', 'chamomile', 'licorice root extract'
            ];
            
            // Check for dangerous ingredients
            for (const ingredient of dangerousIngredients) {
                if (lowerText.includes(ingredient)) {
                    return {
                        safety: 'danger',
                        title: '⚠️ DANGEROUS - AVOID',
                        desc: `This product contains ${ingredient.toUpperCase()} which is potentially harmful. ${getIngredientWarning(ingredient)}`,
                        recommendations: ['Do not use this product', 'Dispose of it safely', 'Consult a doctor if already used'],
                        foundIngredients: [ingredient]
                    };
                }
            }
            
            // Check for irritants
            let foundIrritants = [];
            for (const irritant of irritants) {
                if (lowerText.includes(irritant)) {
                    foundIrritants.push(irritant);
                }
            }
            
            // Check for safe ingredients
            let foundSafe = [];
            for (const safe of safeIngredients) {
                if (lowerText.includes(safe)) {
                    foundSafe.push(safe);
                }
            }
            
            if (foundIrritants.length >= 3) {
                return {
                    safety: 'danger',
                    title: 'Multiple Irritants Detected',
                    desc: `Contains ${foundIrritants.length} potential irritants including ${foundIrritants.slice(0, 3).join(', ')}. High risk of skin reaction.`,
                    recommendations: ['Not recommended for sensitive skin', 'Patch test absolutely required', 'Consider fragrance-free alternatives'],
                    foundIngredients: foundIrritants
                };
            } else if (foundIrritants.length >= 1) {
                return {
                    safety: 'warning',
                    title: 'Potential Irritants Present',
                    desc: `Contains ${foundIrritants.length} potential irritant${foundIrritants.length > 1 ? 's' : ''}. May cause issues for sensitive skin.`,
                    recommendations: ['Patch test recommended', 'Monitor for any reactions', 'Suitable for occasional use only'],
                    foundIngredients: foundIrritants
                };
            } else if (foundSafe.length >= 3) {
                return {
                    safety: 'safe',
                    title: 'Generally Safe',
                    desc: `Contains beneficial ingredients like ${foundSafe.slice(0, 3).join(', ')}. Appears suitable for most skin types.`,
                    recommendations: ['Suitable for regular use', 'No special precautions needed', 'Good formulation'],
                    foundIngredients: foundSafe
                };
            } else {
                return {
                    safety: 'safe',
                    title: 'No Major Red Flags',
                    desc: 'Ingredients appear generally safe with no major concerning ingredients detected.',
                    recommendations: ['Suitable for most users', 'As always, patch test if you have sensitive skin', 'Follow product instructions'],
                    foundIngredients: []
                };
            }
        }
        
        function getIngredientWarning(ingredient) {
            const warnings = {
                'parabens': 'Parabens are preservatives that may disrupt hormones. Consider paraben-free alternatives.',
                'fragrance': 'Fragrance is a common irritant and allergen. Fragrance-free products are better for sensitive skin.',
                'alcohol denat.': 'Denatured alcohol can be very drying and damaging to skin barrier.',
                'sodium lauryl sulfate': 'SLS can strip natural oils and cause irritation, especially for sensitive skin.',
                'phthalates': 'Phthalates are plasticizers linked to hormonal disruption. Avoid in personal care products.',
                'formaldehyde': 'Formaldehyde is a known carcinogen and strong irritant. Strictly avoid.',
                'hydroquinone': 'Hydroquinone can cause ochronosis (skin darkening) with prolonged use.'
            };
            
            return warnings[ingredient] || 'This ingredient has potential health concerns.';
        }
        
