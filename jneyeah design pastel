    <script>
        // Theme Toggle
        const themeToggle = document.getElementById('themeToggle');
        const body = document.body;
        
        themeToggle.addEventListener('click', () => {
            body.classList.toggle('dark-mode');
            localStorage.setItem('theme', body.classList.contains('dark-mode') ? 'dark' : 'light');
        });
        
        // Check for saved theme preference
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark') {
            body.classList.add('dark-mode');
        }
        
        // DOM Elements
        const signInOption = document.getElementById('signInOption');
        const signUpOption = document.getElementById('signUpOption');
        const authToggleSlider = document.getElementById('authToggleSlider');
        const signinForm = document.getElementById('signinForm');
        const signupForm = document.getElementById('signupForm');
        const authTitle = document.getElementById('authTitle');
        const authSubtitle = document.getElementById('authSubtitle');
        
        const sendOtpBtn = document.getElementById('sendOtpBtn');
        const otpSection = document.getElementById('otpSection');
        const otpPhoneNumber = document.getElementById('otpPhoneNumber');
        const verifyOtpBtn = document.getElementById('verifyOtpBtn');
        const passwordField = document.getElementById('password');
        const confirmPasswordField = document.getElementById('confirmPassword');
        const submitBtn = document.getElementById('submitBtn');
        const formStatus = document.getElementById('formStatus');
        
        // Password Rules Elements
        const ruleLength = document.getElementById('rule-length');
        const ruleNumber = document.getElementById('rule-number');
        const ruleSpecial = document.getElementById('rule-special');
        
        // OTP Variables
        let generatedOtp = '';
        let resetOtp = '';
        let otpVerified = false;
        let resetOtpVerified = false;
        
        // Switch between Sign In and Sign Up
        function switchAuth(authType) {
            if (authType === 'signin') {
                signInOption.classList.add('active');
                signUpOption.classList.remove('active');
                authToggleSlider.style.transform = 'translateX(0)';
                signinForm.classList.add('active');
                signupForm.classList.remove('active');
                authTitle.textContent = 'Sign In to Jneyah';
                authSubtitle.textContent = 'Welcome back to your wellness journey';
            } else {
                signUpOption.classList.add('active');
                signInOption.classList.remove('active');
                authToggleSlider.style.transform = 'translateX(100%)';
                signupForm.classList.add('active');
                signinForm.classList.remove('active');
                authTitle.textContent = 'Join Jneyah Today';
                authSubtitle.textContent = 'Start your wellness journey with us';
                
                // Reset OTP section when switching to sign up
                resetOtpSection();
            }
        }
        
        // Reset OTP Section
        function resetOtpSection() {
            otpSection.classList.remove('active');
            otpVerified = false;
            passwordField.disabled = true;
            confirmPasswordField.disabled = true;
            submitBtn.disabled = true;
            
            verifyOtpBtn.innerHTML = '<i class="fas fa-check-circle"></i> Verify OTP';
            verifyOtpBtn.style.background = '';
            verifyOtpBtn.disabled = false;
            
            // Reset password fields
            passwordField.value = '';
            confirmPasswordField.value = '';
            updateRule(ruleLength, false);
            updateRule(ruleNumber, false);
            updateRule(ruleSpecial, false);
            
            // Hide OTP section completely
            otpSection.style.display = 'none';
        }
        
        // Send OTP Function for Sign Up
        function sendOTP() {
            const phone = document.getElementById('phone').value;
            const countryCode = document.getElementById('countryCode').value;
            const fullPhone = countryCode + phone;
            
            // Validate phone number
            if (phone.length < 10) {
                showStatus('Please enter a valid phone number', 'error');
                return;
            }
            
            // Show loading state
            const originalText = sendOtpBtn.innerHTML;
            sendOtpBtn.innerHTML = '<div class="spinner"></div> Sending OTP...';
            sendOtpBtn.disabled = true;
            
            // Simulate API call delay
            setTimeout(() => {
                // Generate random 6-digit OTP
                generatedOtp = Math.floor(100000 + Math.random() * 900000).toString();
                
                // Show OTP section
                otpSection.style.display = 'block';
                otpSection.classList.add('active');
                otpPhoneNumber.textContent = fullPhone;
                
                // Reset OTP inputs
                const otpInputs = document.querySelectorAll('.otp-input');
                otpInputs.forEach(input => input.value = '');
                otpInputs[0].focus();
                
                // Show success message
                showStatus(`OTP sent to ${fullPhone}. For demo, use: ${generatedOtp}`, 'success');
                
                // Reset button
                sendOtpBtn.innerHTML = originalText;
                sendOtpBtn.disabled = false;
                
                console.log(`Generated OTP for ${fullPhone}: ${generatedOtp}`);
                
                // Start OTP expiry timer (5 minutes)
                startOtpTimer();
            }, 1500);
        }
        
        // Send OTP for Password Reset
        function sendResetOTP() {
            const phone = document.getElementById('resetPhone').value;
            const countryCode = document.getElementById('resetCountryCode').value;
            const fullPhone = countryCode + phone;
            
            // Validate phone number
            if (phone.length < 10) {
                showStatus('Please enter a valid phone number', 'error');
                return;
            }
            
            // Show loading state
            const sendBtn = document.querySelector('#forgotPasswordModal .btn-otp');
            const originalText = sendBtn.innerHTML;
            sendBtn.innerHTML = '<div class="spinner"></div> Sending OTP...';
            sendBtn.disabled = true;
            
            // Simulate API call delay
            setTimeout(() => {
                // Generate random 6-digit OTP for reset
                resetOtp = Math.floor(100000 + Math.random() * 900000).toString();
                
                // Show OTP section
                document.getElementById('resetOtpSection').style.display = 'block';
                document.getElementById('resetOtpPhoneNumber').textContent = fullPhone;
                
                // Reset OTP inputs
                const otpInputs = document.querySelectorAll('.modal-otp-input');
                otpInputs.forEach(input => input.value = '');
                otpInputs[0].focus();
                
                // Show success message
                showStatus(`OTP sent to ${fullPhone}. For demo, use: ${resetOtp}`, 'success');
                
                // Reset button
                sendBtn.innerHTML = originalText;
                sendBtn.disabled = false;
                
                console.log(`Reset OTP for ${fullPhone}: ${resetOtp}`);
            }, 1500);
        }
        
        // OTP Timer for Sign Up
        function startOtpTimer() {
            let timeLeft = 300; // 5 minutes in seconds
            
            const timerInterval = setInterval(() => {
                timeLeft--;
                
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    showStatus('OTP has expired. Please request a new one.', 'error');
                    generatedOtp = '';
                    otpSection.classList.remove('active');
                }
            }, 1000);
        }
        
        // Move to next OTP input for Sign Up
        function moveToNext(current, nextIndex) {
            // Allow only numbers
            current.value = current.value.replace(/[^0-9]/g, '');
            
            if (current.value.length === 1) {
                const nextInput = document.querySelector(`.otp-input:nth-child(${nextIndex + 1})`);
                if (nextInput) {
                    nextInput.focus();
                }
            }
        }
        
        // Move to next OTP input for Modal
        function moveToNextModal(current, nextIndex) {
            // Allow only numbers
            current.value = current.value.replace(/[^0-9]/g, '');
            
            if (current.value.length === 1) {
                const nextInput = document.querySelector(`.modal-otp-input:nth-child(${nextIndex + 1})`);
                if (nextInput) {
                    nextInput.focus();
                }
            }
            
            // Auto verify if all 6 digits are entered
            const otpInputs = document.querySelectorAll('.modal-otp-input');
            let enteredOtp = '';
            otpInputs.forEach(input => enteredOtp += input.value);
            
            if (enteredOtp.length === 6) {
                verifyResetOTP();
            }
        }
        
        // Verify OTP for Sign Up
        function verifyOTP() {
            const otpInputs = document.querySelectorAll('.otp-input');
            let enteredOtp = '';
            otpInputs.forEach(input => enteredOtp += input.value);
            
            // Show loading state
            const originalText = verifyOtpBtn.innerHTML;
            verifyOtpBtn.innerHTML = '<div class="spinner"></div> Verifying...';
            verifyOtpBtn.disabled = true;
            
            // Simulate verification delay
            setTimeout(() => {
                if (enteredOtp === generatedOtp) {
                    // OTP Verified
                    otpVerified = true;
                    showStatus('OTP verified successfully! You can now set your password.', 'success');
                    
                    // Enable password fields
                    passwordField.disabled = false;
                    confirmPasswordField.disabled = false;
                    
                    // Enable submit button (but still need password validation)
                    submitBtn.disabled = false;
                    
                    // Change OTP button to verified
                    verifyOtpBtn.innerHTML = '<i class="fas fa-check-circle"></i> Verified';
                    verifyOtpBtn.style.background = 'var(--success)';
                    verifyOtpBtn.disabled = true;
                    
                    // Focus on password field
                    passwordField.focus();
                } else {
                    // Invalid OTP
                    showStatus('Invalid OTP. Please try again.', 'error');
                    verifyOtpBtn.innerHTML = originalText;
                    verifyOtpBtn.disabled = false;
                    
                    // Clear OTP inputs
                    const otpInputs = document.querySelectorAll('.otp-input');
                    otpInputs.forEach(input => input.value = '');
                    otpInputs[0].focus();
                }
            }, 1000);
        }
        
        // Verify OTP for Password Reset
        function verifyResetOTP() {
            const otpInputs = document.querySelectorAll('.modal-otp-input');
            let enteredOtp = '';
            otpInputs.forEach(input => enteredOtp += input.value);
            
            if (enteredOtp === resetOtp) {
                // OTP Verified
                resetOtpVerified = true;
                
                // Hide OTP section, show new password section
                document.getElementById('resetOtpSection').style.display = 'none';
                document.getElementById('newPasswordSection').style.display = 'block';
                
                // Focus on new password field
                document.getElementById('newPassword').focus();
                
                showStatus('OTP verified! Now set your new password.', 'success');
            } else {
                showStatus('Invalid OTP. Please try again.', 'error');
            }
        }
        
        // Update Password
        function updatePassword() {
            const newPassword = document.getElementById('newPassword').value;
            const confirmNewPassword = document.getElementById('confirmNewPassword').value;
            
            if (newPassword !== confirmNewPassword) {
                showStatus('Passwords do not match.', 'error');
                return;
            }
            
            if (newPassword.length < 8) {
                showStatus('Password must be at least 8 characters.', 'error');
                return;
            }
            
            // Show loading
            const resetBtn = document.querySelector('#newPasswordSection .btn');
            const originalText = resetBtn.innerHTML;
            resetBtn.innerHTML = '<div class="spinner"></div> Updating...';
            resetBtn.disabled = true;
            
            // Simulate API call
            setTimeout(() => {
                showStatus('Password reset successfully! You can now sign in.', 'success');
                closeForgotPassword();
                
                // Reset modal
                resetBtn.innerHTML = originalText;
                resetBtn.disabled = false;
                document.getElementById('resetOtpSection').style.display = 'none';
                document.getElementById('newPasswordSection').style.display = 'none';
                document.getElementById('resetPhone').value = '';
                document.getElementById('newPassword').value = '';
                document.getElementById('confirmNewPassword').value = '';
                
                // Switch to sign in
                switchAuth('signin');
            }, 1500);
        }
        
        // Password Validation for Sign Up
        passwordField.addEventListener('input', validatePassword);
        confirmPasswordField.addEventListener('input', validatePassword);
        
        function validatePassword() {
            const password = passwordField.value;
            const confirmPassword = confirmPasswordField.value;
            
            // Check password rules
            const hasMinLength = password.length >= 8;
            const hasNumber = /\d/.test(password);
            const hasSpecial = /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password);
            
            // Update rule indicators
            updateRule(ruleLength, hasMinLength);
            updateRule(ruleNumber, hasNumber);
            updateRule(ruleSpecial, hasSpecial);
            
            // Check if passwords match
            const passwordsMatch = password === confirmPassword && password.length > 0;
            
            // Enable/disable submit button
            const isPasswordValid = hasMinLength && hasNumber && hasSpecial && passwordsMatch;
            submitBtn.disabled = !(otpVerified && isPasswordValid);
            
            // Show password match status
            if (confirmPassword.length > 0) {
                if (passwordsMatch) {
                    confirmPasswordField.style.borderColor = 'var(--success)';
                } else {
                    confirmPasswordField.style.borderColor = 'var(--error)';
                }
            } else {
                confirmPasswordField.style.borderColor = 'var(--border-light)';
            }
        }
        
        function updateRule(ruleElement, isValid) {
            if (isValid) {
                ruleElement.classList.remove('invalid');
                ruleElement.classList.add('valid');
                ruleElement.innerHTML = '<i class="fas fa-check-circle"></i> ' + ruleElement.textContent.substring(ruleElement.textContent.indexOf(' ') + 1);
            } else {
                ruleElement.classList.remove('valid');
                ruleElement.classList.add('invalid');
                ruleElement.innerHTML = '<i class="fas fa-circle"></i> ' + ruleElement.textContent.substring(ruleElement.textContent.indexOf(' ') + 1);
            }
        }
        
        // Toggle password visibility
        function togglePassword(inputId) {
            const passwordInput = document.getElementById(inputId);
            const toggleIcon = passwordInput.parentElement.querySelector('i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }
        
        // Social Login Function
        function socialLogin(provider) {
            showStatus(`Redirecting to ${provider} authentication...`, 'success');
            // In real app, you would redirect to OAuth
        }
        
        // Show status message
        function showStatus(message, type) {
            formStatus.textContent = message;
            formStatus.className = 'form-status ' + type;
            
            // Auto hide after 5 seconds
            setTimeout(() => {
                formStatus.className = 'form-status';
                formStatus.textContent = '';
            }, 5000);
        }
        
        // Sign In Form Submission
        document.getElementById('signinForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const countryCode = document.getElementById('signinCountryCode').value;
            const phone = document.getElementById('signinPhone').value;
            const password = document.getElementById('signinPassword').value;
            const fullPhone = countryCode + phone;
            
            // Show loading state
            const submitBtn = this.querySelector('.btn');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<div class="spinner"></div> Signing In...';
            submitBtn.disabled = true;
            
            // Simulate sign in process
            setTimeout(() => {
                if (phone && password) {
                    showStatus(`Welcome back! Signed in with ${fullPhone}`, 'success');
                    
                    // Reset form
                    this.reset();
                } else {
                    showStatus('Please fill in all fields', 'error');
                }
                
                // Reset button
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }, 1500);
        });
        
        // Sign Up Form Submission
        document.getElementById('signupForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            if (!otpVerified) {
                showStatus('Please verify your OTP first.', 'error');
                return;
            }
            
            // Check password validation
            const password = passwordField.value;
            const confirmPassword = confirmPasswordField.value;
            
            if (password !== confirmPassword) {
                showStatus('Passwords do not match.', 'error');
                return;
            }
            
            // Show loading state
            submitBtn.innerHTML = '<div class="spinner"></div> Creating Account...';
            submitBtn.disabled = true;
            
            // Simulate account creation
            setTimeout(() => {
                // Get form data
                const formData = {
                    name: document.getElementById('fullName').value,
                    email: document.getElementById('email').value,
                    phone: document.getElementById('countryCode').value + document.getElementById('phone').value
                };
                
                // Show success message
                showStatus(`Account created successfully! Welcome to Jneyah, ${formData.name}.`, 'success');
                
                // Reset form
                this.reset();
                
                // Reset OTP section
                resetOtpSection();
                
                // Switch to sign in
                setTimeout(() => {
                    switchAuth('signin');
                }, 2000);
                
                console.log('Account created:', formData);
            }, 2000);
        });
        
        // Forgot Password Modal
        function openForgotPassword() {
            document.getElementById('forgotPasswordModal').style.display = 'flex';
            document.getElementById('resetPhone').focus();
        }
        
        function closeForgotPassword() {
            document.getElementById('forgotPasswordModal').style.display = 'none';
            
            // Reset modal state
            document.getElementById('resetOtpSection').style.display = 'none';
            document.getElementById('newPasswordSection').style.display = 'none';
            document.getElementById('resetPhone').value = '';
            document.getElementById('newPassword').value = '';
            document.getElementById('confirmNewPassword').value = '';
            
            const otpInputs = document.querySelectorAll('.modal-otp-input');
            otpInputs.forEach(input => input.value = '');
        }
        
        // Close modal when clicking outside
        window.addEventListener('click', function(e) {
            const modal = document.getElementById('forgotPasswordModal');
            if (modal && e.target === modal) {
                closeForgotPassword();
            }
        });
        
        // Auto-focus on first input
        document.getElementById('signinPhone').focus();
    </script>
</body>
</html>
