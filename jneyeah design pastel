            <button class="btn btn-otp" onclick="sendResetOTP()">
                <i class="fas fa-mobile-alt"></i> Send OTP
            </button>
            
            <!-- OTP Input Section -->
            <div class="input-group" id="resetOtpSection" style="display: none; margin-top: 20px;">
                <label>Enter OTP</label>
                <div class="modal-otp-inputs">
                    <input type="text" class="modal-otp-input" maxlength="1" oninput="moveToNextModal(this, 1)">
                    <input type="text" class="modal-otp-input" maxlength="1" oninput="moveToNextModal(this, 2)">
                    <input type="text" class="modal-otp-input" maxlength="1" oninput="moveToNextModal(this, 3)">
                    <input type="text" class="modal-otp-input" maxlength="1" oninput="moveToNextModal(this, 4)">
                    <input type="text" class="modal-otp-input" maxlength="1" oninput="moveToNextModal(this, 5)">
                    <input type="text" class="modal-otp-input" maxlength="1" oninput="moveToNextModal(this, 6)">
                </div>
                <p style="font-size: 0.85rem; color: var(--text-light); margin-top: 8px; text-align: center;">
                    OTP sent to <span id="resetOtpPhoneNumber"></span>
                </p>
