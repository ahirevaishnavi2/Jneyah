                <p>Enter your phone number to receive an OTP</p>
            </div>
            
            <!-- Phone Number Input -->
            <div class="input-group">
                <label for="resetPhone">Phone Number</label>
                <div class="phone-input-container">
                    <div class="country-code">
                        <select id="resetCountryCode">
