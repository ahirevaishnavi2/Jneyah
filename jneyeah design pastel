<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jneyah - Sign In & Sign Up</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', 'Poppins', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
        }
        
        :root {
            --primary: #8a4b75;
            --primary-light: #a56b8f;
            --primary-dark: #6a395a;
            --secondary: #ffb6c1;
            --secondary-light: #ffd9e2;
            --accent: #d4a5c6;
            --background: #fef8f5;
            --card: #ffffff;
            --text: #333333;
            --text-light: #666666;
            --text-lighter: #888888;
            --border: #e0c8d5;
            --border-light: #f0e0e8;
            --success: #4CAF50;
            --error: #f44336;
            --shadow: rgba(138, 75, 117, 0.08);
            --shadow-dark: rgba(138, 75, 117, 0.15);
            --radius: 16px;
            --radius-sm: 10px;
        }
        
        .dark-mode {
            --primary: #d89bc3;
            --primary-light: #e6b5d3;
            --primary-dark: #c97fb0;
            --secondary: #8a4b75;
            --secondary-light: #a56b8f;
            --accent: #b07ca0;
            --background: #1a1a2e;
            --card: #16213e;
            --text: #f0f0f0;
            --text-light: #cccccc;
            --text-lighter: #aaaaaa;
            --border: #2d3748;
            --border-light: #374151;
            --success: #66bb6a;
            --error: #ef5350;
            --shadow: rgba(0, 0, 0, 0.25);
            --shadow-dark: rgba(0, 0, 0, 0.4);
        }
        
        body {
            background-color: var(--background);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            background-image: linear-gradient(135deg, var(--secondary-light) 0%, var(--background) 100%);
        }
        
        .dark-mode body {
            background-image: linear-gradient(135deg, var(--secondary) 0%, var(--background) 100%);
        }
        
        .container {
            display: flex;
            width: 100%;
            max-width: 1100px;
            min-height: 650px;
            box-shadow: 0 25px 60px var(--shadow-dark);
            border-radius: var(--radius);
            overflow: hidden;
            position: relative;
        }
        
        /* Theme Toggle */
        .theme-toggle {
            position: absolute;
            top: 25px;
            right: 25px;
            z-index: 100;
        }
        
        .toggle-btn {
            width: 60px;
            height: 30px;
            background: var(--card);
            border-radius: 50px;
            position: relative;
            cursor: pointer;
            border: 2px solid var(--border);
            box-shadow: 0 4px 12px var(--shadow);
        }
        
        .toggle-slider {
            position: absolute;
            top: 3px;
            left: 3px;
            width: 22px;
            height: 22px;
            background: var(--primary);
            border-radius: 50%;
            transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }
        
        .dark-mode .toggle-slider {
            transform: translateX(30px);
        }
        
        .toggle-icon {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            color: var(--primary);
        }
        
        .sun {
            left: 8px;
        }
        
        .moon {
            right: 8px;
        }
        
        /* Brand Section */
        .brand-section {
            flex: 1;
            background: linear-gradient(145deg, var(--secondary) 0%, var(--secondary-light) 100%);
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            text-align: center;
        }
        
        .dark-mode .brand-section {
            background: linear-gradient(145deg, var(--secondary) 0%, var(--primary-light) 100%);
        }
        
        .brand-section::before {
            content: '';
            position: absolute;
            top: -30%;
            right: -20%;
            width: 250px;
            height: 250px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 50%;
            filter: blur(20px);
        }
        
        .brand-section::after {
            content: '';
            position: absolute;
            bottom: -20%;
            left: -10%;
            width: 200px;
            height: 200px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            filter: blur(15px);
        }
        
        .brand-logo {
            position: relative;
            z-index: 2;
            margin-bottom: 25px;
        }
        
        .brand-name {
            font-size: 3.8rem;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: 2px;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 10px;
        }
        
        .dark-mode .brand-name {
            color: #ffffff;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
        }
        
        .brand-tagline {
            font-size: 1.2rem;
            color: var(--primary);
            font-weight: 500;
            position: relative;
            z-index: 2;
            max-width: 300px;
            line-height: 1.5;
            font-style: italic;
            padding: 10px 20px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            backdrop-filter: blur(5px);
        }
        
        .dark-mode .brand-tagline {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
        }
        
        /* Registration Section */
        .registration-section {
            flex: 1.2;
            background: var(--card);
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        
        .registration-header {
            margin-bottom: 30px;
            text-align: center;
        }
        
        .registration-header h2 {
            color: var(--primary);
            font-size: 2.2rem;
            margin-bottom: 8px;
            font-weight: 700;
        }
        
        .registration-header p {
            color: var(--text-light);
            font-size: 1rem;
            font-weight: 400;
        }
        
        /* Auth Toggle */
        .auth-toggle-container {
            display: flex;
            background: var(--background);
            border-radius: 50px;
            padding: 5px;
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
            border: 1px solid var(--border);
        }
        
        .auth-toggle-slider {
            position: absolute;
            top: 5px;
            left: 5px;
            width: calc(50% - 5px);
            height: calc(100% - 10px);
            background: var(--primary);
            border-radius: 50px;
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            box-shadow: 0 4px 12px rgba(138, 75, 117, 0.3);
        }
        
        .dark-mode .auth-toggle-slider {
            box-shadow: 0 4px 12px rgba(216, 155, 195, 0.4);
        }
        
        .auth-toggle-option {
            flex: 1;
            text-align: center;
            padding: 14px;
            cursor: pointer;
            z-index: 2;
            font-weight: 600;
            color: var(--text-light);
            transition: all 0.3s ease;
        }
        
        .auth-toggle-option.active {
            color: white;
        }
        
        /* Form Styles */
        .form-container {
            width: 100%;
        }
        
        .form-step {
            display: none;
            animation: fadeIn 0.5s ease;
        }
        
        .form-step.active {
            display: block;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .input-group {
            margin-bottom: 22px;
        }
        
        .input-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text);
            font-weight: 600;
            font-size: 0.95rem;
        }
        
        .input-group input, .phone-input-container {
            width: 100%;
            padding: 16px 18px;
            border: 2px solid var(--border-light);
            border-radius: var(--radius-sm);
            font-size: 1rem;
            transition: all 0.3s;
            background: var(--background);
            color: var(--text);
        }
        
        .input-group input:focus, .phone-input-container:focus-within {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--shadow);
        }
        
        .dark-mode .input-group input:focus, .dark-mode .phone-input-container:focus-within {
            box-shadow: 0 0 0 3px rgba(216, 155, 195, 0.2);
        }
        
        /* Phone Input with Country Code */
        .phone-input-container {
            display: flex;
            padding: 0;
            overflow: hidden;
        }
        
        .country-code {
            display: flex;
            align-items: center;
            padding: 0 15px;
            background: var(--border-light);
            color: var(--text);
            font-weight: 600;
            border-right: 2px solid var(--border);
            min-width: 100px;
        }
        
        .country-code select {
            background: transparent;
            border: none;
            color: var(--text);
            font-weight: 600;
            font-size: 1rem;
            outline: none;
            width: 100%;
            cursor: pointer;
        }
        
        .phone-input-container input {
            flex: 1;
            border: none;
            padding: 16px 18px;
            background: transparent;
            color: var(--text);
        }
        
        .phone-input-container input:focus {
            box-shadow: none;
        }
        
        /* Password Container */
        .password-container {
            position: relative;
        }
        
        .password-toggle {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-lighter);
            cursor: pointer;
            font-size: 1.2rem;
            transition: color 0.2s;
        }
        
        .password-toggle:hover {
            color: var(--primary);
        }
        
        /* Forgot Password */
        .forgot-password {
            text-align: right;
            margin-top: 5px;
            margin-bottom: 20px;
        }
        
        .forgot-password a {
            color: var(--primary);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
        }
        
        .forgot-password a:hover {
            text-decoration: underline;
        }
        
        /* Remember Me */
        .remember-me {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .remember-me input {
            margin-right: 8px;
            accent-color: var(--primary);
            cursor: pointer;
        }
        
        .remember-me label {
            color: var(--text-light);
            font-size: 0.9rem;
            cursor: pointer;
        }
        
        /* OTP Section */
        .otp-section {
            margin-top: 10px;
            display: none;
        }
        
        .otp-section.active {
            display: block;
            animation: slideDown 0.4s ease;
        }
        
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .otp-inputs {
            display: flex;
            gap: 12px;
            margin-top: 10px;
        }
        
        .otp-input {
            flex: 1;
            height: 60px;
            text-align: center;
            font-size: 1.5rem;
            font-weight: 700;
            border: 2px solid var(--border-light);
            border-radius: var(--radius-sm);
            background: var(--background);
            color: var(--text);
            transition: all 0.2s;
        }
        
        .otp-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--shadow);
            outline: none;
        }
        
        .otp-helper {
            font-size: 0.85rem;
            color: var(--text-light);
            margin-top: 8px;
            text-align: center;
        }
        
        .otp-helper .phone-number {
            font-weight: 600;
            color: var(--primary);
        }
        
        /* Password Rules */
        .password-rules {
            background: var(--background);
            padding: 15px;
            border-radius: var(--radius-sm);
            margin-top: 10px;
            border-left: 4px solid var(--primary);
        }
        
        .password-rules h4 {
            color: var(--text);
            font-size: 0.9rem;
            margin-bottom: 8px;
            font-weight: 600;
        }
        
        .password-rules ul {
            list-style: none;
            padding-left: 5px;
        }
        
        .password-rules li {
            color: var(--text-light);
            font-size: 0.85rem;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
        }
        
        .password-rules li i {
            margin-right: 8px;
            font-size: 0.8rem;
        }
        
        .password-rules li.valid {
            color: var(--success);
        }
        
        .password-rules li.invalid {
            color: var(--text-lighter);
        }
        
        /* Consent Checkbox */
        .consent-group {
            margin: 25px 0;
            padding: 15px;
            background: var(--background);
            border-radius: var(--radius-sm);
            border: 2px solid var(--border-light);
        }
        
        .consent-checkbox {
            display: flex;
            align-items: flex-start;
        }
        
        .consent-checkbox input {
            margin-top: 3px;
            margin-right: 12px;
            accent-color: var(--primary);
            cursor: pointer;
        }
        
        .consent-checkbox label {
            color: var(--text);
            font-size: 0.9rem;
            line-height: 1.5;
            cursor: pointer;
        }
        
        .consent-checkbox a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }
        
        .consent-checkbox a:hover {
            text-decoration: underline;
        }
        
        /* Buttons */
        .btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 18px;
            border-radius: var(--radius-sm);
            font-size: 1.05rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            width: 100%;
            margin-top: 5px;
            letter-spacing: 0.5px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }
        
        .btn:hover {
            background: var(--primary-light);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(138, 75, 117, 0.25);
        }
        
        .dark-mode .btn:hover {
            box-shadow: 0 8px 20px rgba(216, 155, 195, 0.3);
        }
        
        .btn:active {
            transform: translateY(0);
        }
        
        .btn:disabled {
            background: var(--border);
            color: var(--text-lighter);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        
        .btn-otp {
            background: var(--secondary);
            color: var(--primary);
            font-weight: 700;
        }
        
        .btn-otp:hover {
            background: var(--secondary-light);
            color: var(--primary);
        }
        
        /* Social Login Section */
        .social-section {
            margin-top: 25px;
            text-align: center;
        }
        
        .social-title {
            color: var(--text-light);
            font-size: 0.95rem;
            margin-bottom: 15px;
            position: relative;
        }
        
        .social-title::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            width: 30%;
            height: 1px;
            background: var(--border);
        }
        
        .social-title::after {
            content: '';
            position: absolute;
            top: 50%;
            right: 0;
            width: 30%;
            height: 1px;
            background: var(--border);
        }
        
        .social-login {
            display: flex;
            justify-content: center;
            gap: 15px;
        }
        
        .social-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--background);
            color: var(--text);
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s;
            border: 1px solid var(--border);
        }
        
        .social-btn:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-3px);
        }
        
        .social-btn.google:hover {
            background: #DB4437;
        }
        
        .social-btn.facebook:hover {
            background: #4267B2;
        }
        
        /* Form Status */
        .form-status {
            text-align: center;
            margin-top: 20px;
            padding: 12px;
            border-radius: var(--radius-sm);
            font-size: 0.9rem;
            display: none;
        }
        
        .form-status.success {
            background: rgba(76, 175, 80, 0.1);
            color: var(--success);
            border: 1px solid rgba(76, 175, 80, 0.3);
            display: block;
        }
        
        .form-status.error {
            background: rgba(244, 67, 54, 0.1);
            color: var(--error);
            border: 1px solid rgba(244, 67, 54, 0.3);
            display: block;
        }
        
        /* Switch Auth Link */
        .switch-auth {
            text-align: center;
            margin-top: 20px;
            color: var(--text-light);
            font-size: 0.9rem;
        }
        
        .switch-auth a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
            margin-left: 5px;
        }
        
        .switch-auth a:hover {
            text-decoration: underline;
        }
        
        /* Forgot Password Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        
        .modal-content {
            background: var(--card);
            padding: 30px;
            border-radius: 20px;
            width: 90%;
            max-width: 450px;
            box-shadow: 0 20px 40px var(--shadow-dark);
        }
        
        .modal-header {
            margin-bottom: 20px;
            text-align: center;
        }
        
        .modal-header h3 {
            color: var(--primary);
            font-size: 1.5rem;
            margin-bottom: 10px;
        }
        
        .modal-header p {
            color: var(--text-light);
            font-size: 0.95rem;
        }
        
        .close-modal {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--text-light);
            cursor: pointer;
        }
        
        .modal-otp-inputs {
            display: flex;
            gap: 10px;
            margin: 15px 0;
        }
        
        .modal-otp-input {
            flex: 1;
            height: 55px;
            text-align: center;
            font-size: 1.3rem;
            font-weight: 700;
            border: 2px solid var(--border-light);
            border-radius: var(--radius-sm);
            background: var(--background);
            color: var(--text);
        }
        
        .modal-otp-input:focus {
            border-color: var(--primary);
            outline: none;
        }
        
        /* Responsive */
        @media (max-width: 900px) {
            .container {
                flex-direction: column;
                max-width: 550px;
                min-height: auto;
            }
            
            .brand-name {
                font-size: 3rem;
            }
            
            .brand-section, .registration-section {
                padding: 40px 30px;
            }
            
            .otp-inputs {
                gap: 8px;
            }
            
            .otp-input {
                height: 55px;
                font-size: 1.3rem;
            }
        }
        
        @media (max-width: 480px) {
            .container {
                border-radius: 12px;
            }
            
            .brand-name {
                font-size: 2.5rem;
            }
            
            .brand-section, .registration-section {
                padding: 30px 20px;
            }
            
            .otp-inputs {
                gap: 6px;
            }
            
            .otp-input {
                height: 50px;
                font-size: 1.2rem;
            }
            
            .phone-input-container {
                flex-direction: column;
            }
            
            .country-code {
                border-right: none;
                border-bottom: 2px solid var(--border);
                min-width: auto;
                padding: 10px 15px;
            }
            
            .phone-input-container input {
                padding: 16px 18px;
            }
            
            .social-title::before,
            .social-title::after {
                width: 25%;
            }
        }
        
        /* Animation for the brand name */
        @keyframes glow {
            0%, 100% { text-shadow: 0 0 10px rgba(255, 255, 255, 0.5); }
            50% { text-shadow: 0 0 20px rgba(255, 255, 255, 0.8), 0 0 30px rgba(255, 255, 255, 0.6); }
        }
        
        .dark-mode .brand-name {
            animation: glow 4s infinite ease-in-out;
        }
        
        .brand-name {
            transition: all 0.3s ease;
        }
        
        .brand-name:hover {
            transform: scale(1.02);
        }
        
        /* Loading Spinner */
        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s ease-in-out infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* Field Disabled State */
        .input-group input:disabled {
            background: var(--border-light);
            color: var(--text-lighter);
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Theme Toggle -->
        <div class="theme-toggle">
            <div class="toggle-btn" id="themeToggle">
                <div class="toggle-slider"></div>
                <span class="toggle-icon sun"><i class="fas fa-sun"></i></span>
                <span class="toggle-icon moon"><i class="fas fa-moon"></i></span>
            </div>
        </div>
        
        <!-- Brand Section -->
        <div class="brand-section">
            <div class="brand-logo">
                <h1 class="brand-name">JNEYAH</h1>
                <p class="brand-tagline">Where truth is identified before belief</p>
            </div>
        </div>
        
        <!-- Registration Section -->
        <div class="registration-section">
            <div class="registration-header">
                <h2 id="authTitle">Sign In to Jneyah</h2>
                <p id="authSubtitle">Welcome back to your wellness journey</p>
            </div>
            
            <!-- Auth Toggle -->
            <div class="auth-toggle-container">
                <div class="auth-toggle-slider" id="authToggleSlider"></div>
                <div class="auth-toggle-option active" id="signInOption" onclick="switchAuth('signin')">
                    Sign In
                </div>
                <div class="auth-toggle-option" id="signUpOption" onclick="switchAuth('signup')">
                    Sign Up
                </div>
            </div>
            
            <!-- Form Container -->
            <div class="form-container">
                <!-- SIGN IN FORM -->
                <form id="signinForm" class="form-step active">
